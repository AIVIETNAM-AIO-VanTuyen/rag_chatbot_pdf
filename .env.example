# Sao chép file này thành .env rồi chỉnh theo nhu cầu.
# Chỉ GEMINI_API_KEY là bắt buộc; các khoá còn lại bỏ trống thì dùng giá trị
# mặc định trong app/infra/settings.py.

# --- Google Gemini (bắt buộc) ---
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_LLM_MODEL=gemini-3.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Số văn bản gửi mỗi lần gọi API nhúng, và thời gian nghỉ giữa các batch
# (giúp tránh lỗi rate limit 429).
# GEMINI_EMBED_BATCH_SIZE=20
# GEMINI_BATCH_PAUSE_SECONDS=1.0

# --- Vector database ---
# Bỏ trống = chạy in-memory, dữ liệu mất khi tắt app.
# Điền đường dẫn để lưu xuống ổ cứng, ví dụ: ./data/chroma_db
# CHROMA_PERSIST_DIR=

# --- Xử lý tài liệu ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_PDF_MB=25
# MAX_PDF_PAGES=500

# --- Truy hồi & sinh câu trả lời ---
# RETRIEVAL_TOP_K=4
# HISTORY_TURNS=6

# --- Đăng nhập (tài khoản demo, sẽ thay bằng xác thực thật ở Phase 3) ---
# AUTH_USERNAME=admin
# AUTH_PASSWORD=admin123

# --- Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL ---
# LOG_LEVEL=INFO
